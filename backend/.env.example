# Backend
PORT=5000
FLASK_DEBUG=False
# Comma-separated frontend origins in production, e.g. https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000

# Supabase: use the server-side secret key only in the backend.
# NEVER expose this value to the Next.js frontend or commit real secrets to GitHub.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-secret-key

# Gmail SMTP (optional only if email notifications are required)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
